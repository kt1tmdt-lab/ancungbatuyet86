# Copy to .env and set values.
# Local Postgres example:
# DATABASE_URL="postgresql://postgres:12345@localhost:5432/acbt_db?schema=public"
#
# Hosted Postgres example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"
DATABASE_URL=""
JWT_SECRET="change-this-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-T551F0HFS0"
# Numeric GA4 Property ID (not the G- measurement ID)
GOOGLE_ANALYTICS_PROPERTY_ID="553496232"
# Service account with Viewer access to the GA4 property
GOOGLE_ANALYTICS_CLIENT_EMAIL=""
# Keep line breaks encoded as \\n when storing this value on the VPS
GOOGLE_ANALYTICS_PRIVATE_KEY=""

# Telegram notifications for new distributor/wholesale registrations
# Create the bot with @BotFather. Group IDs are usually negative numbers.
TELEGRAM_BOT_TOKEN=""
# Dedicated group for distributor registrations
TELEGRAM_CONTACT_CHAT_ID=""
# Optional: separate destination for CMS audit notifications
TELEGRAM_CHAT_ID=""

# Optional map providers (defaults to OpenStreetMap public services)
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# VPS local uploads
# Development default: leave blank to use ./public/uploads and /uploads
# Production example:
# UPLOAD_DIR="/var/www/acbt-uploads"
# UPLOAD_PUBLIC_URL="https://your-domain.com/uploads"
UPLOAD_DIR=""
UPLOAD_PUBLIC_URL=""
UPLOAD_MAX_MB="50"
